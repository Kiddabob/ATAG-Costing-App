<Project>
  <PropertyGroup>
    <!--
      This is the single version source for the app binary, Velopack package,
      installer and GitHub release workflow. Keep it as a three-part SemVer.
    -->
    <CostingAppVersion>0.3.1</CostingAppVersion>
    <Version>$(CostingAppVersion)</Version>
    <InformationalVersion>$(CostingAppVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AtagPublicReview)' == 'true'">
    <!--
      Public artifacts must not retain CodeView/PDB paths from the development
      computer. This applies to every referenced ATAG project, not only WinUI.
    -->
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
</Project>
