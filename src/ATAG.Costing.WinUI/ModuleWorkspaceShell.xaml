<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATAG.Costing.WinUI.ModuleWorkspaceShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ATAG.Costing.WinUI">

    <Grid SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header content remains visible while the module body scrolls. -->
        <ContentPresenter
            x:Name="HeaderPresenter"
            Content="{x:Bind HeaderContent, Mode=OneWay}" />

        <Grid
            x:Name="AdaptiveWorkspace"
            Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BottomPreviewRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="10" />
                <ColumnDefinition x:Name="PreviewColumn" Width="480" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                x:Name="WorkspaceScroller"
                Grid.Row="0"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch">
                <ContentPresenter
                    HorizontalAlignment="Stretch"
                    Content="{x:Bind WorkspaceContent, Mode=OneWay}" />
            </ScrollViewer>

            <local:HorizontalResizeGrip
                x:Name="ResizeHandle"
                Grid.Row="0"
                Grid.Column="1"
                Background="Transparent"
                PointerCanceled="ResizeHandle_PointerCanceled"
                PointerEntered="ResizeHandle_PointerEntered"
                PointerExited="ResizeHandle_PointerExited"
                PointerMoved="ResizeHandle_PointerMoved"
                PointerPressed="ResizeHandle_PointerPressed"
                PointerReleased="ResizeHandle_PointerReleased">
                <Border
                    x:Name="ResizeIndicator"
                    Width="2"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="2" />
            </local:HorizontalResizeGrip>

            <Border
                x:Name="PreviewPanel"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,12,24,48"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <ScrollViewer HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="14">
                        <!-- Guidance stays available even while expensive
                             module-specific preview geometry is switched off. -->
                        <ContentPresenter
                            x:Name="GuidancePresenter"
                            HorizontalAlignment="Stretch"
                            Content="{x:Bind PreviewGuidanceContent, Mode=OneWay}" />

                        <Rectangle
                            Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock
                                    Style="{StaticResource ModuleSectionTitleStyle}"
                                    Text="{x:Bind PreviewTitle, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource ModuleSupportingTextStyle}"
                                    Text="{x:Bind PreviewSubtitle, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="DockModeText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="Resizable right-hand dock · drag the divider"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="PreviewToggle"
                                Grid.Column="1"
                                Header="Preview"
                                OffContent="Off"
                                OnContent="On"
                                Toggled="PreviewToggle_Toggled" />
                        </Grid>

                        <InfoBar
                            x:Name="PreviewOffInfoBar"
                            Style="{StaticResource ModuleStatusInfoBarStyle}"
                            Message="{x:Bind PreviewOffMessage, Mode=OneWay}"
                            Severity="Informational"
                            Title="Preview paused" />

                        <ContentPresenter
                            x:Name="PreviewContentPresenter"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
