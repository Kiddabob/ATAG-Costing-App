<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATAG.Costing.WinUI.BraidCalculatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ATAG.Costing.WinUI">

    <UserControl.Resources>
        <DataTemplate x:Key="BraidCalculationStepTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource ModuleBackgroundCardStyle}">
                <StackPanel Spacing="5">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Result}" TextAlignment="Right" />
                    </Grid>
                    <TextBlock Style="{StaticResource ModuleSupportingTextStyle}" Text="{Binding BusinessMeaning}" />
                    <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding Formula}" TextWrapping="Wrap" />
                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SubstitutedFormula}" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding RoundingRule}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <local:ModuleWorkspaceShell
        IsPreviewEnabled="False"
        PreviewOffMessage="Turn on LIVE Preview to compare the 16- and 24-carrier braid paths. The labelled calculations remain available while it is off."
        PreviewSubtitle="Coverage and lay geometry update from the visible Braid inputs."
        PreviewTitle="LIVE Braid Preview">
        <local:ModuleWorkspaceShell.HeaderContent>
            <Border Margin="32,8,32,6" Style="{StaticResource ModuleHeaderCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="BRAID COVERAGE MODULE" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="Set the cable, compare the carriers, and see every formula." TextWrapping="Wrap" />
                        <TextBlock MaxWidth="850" Style="{StaticResource ModuleSupportingTextStyle}" Text="The core lay-up factors and braid formula come from the workbook calculator. Braid wire comes from the retained Copper table and results update immediately as an input changes." />
                    </StackPanel>
                    <InfoBar
                        Grid.Column="1"
                        MaxWidth="420"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModuleStatusInfoBarStyle}"
                        Message="{Binding CalculationStatus}"
                        Severity="Success"
                        Title="LIVE calculation" />
                </Grid>
            </Border>
        </local:ModuleWorkspaceShell.HeaderContent>

        <local:ModuleWorkspaceShell.PreviewGuidanceContent>
            <InfoBar
                Style="{StaticResource ModuleStatusInfoBarStyle}"
                Message="Pitch, coverage, strand length and exact gear matches are the authoritative outputs. Preview colour and geometry make the construction easier to scan; they never alter those values."
                Severity="Informational"
                Title="Preview boundary" />
        </local:ModuleWorkspaceShell.PreviewGuidanceContent>

        <local:ModuleWorkspaceShell.PreviewContent>
            <local:BraidLivePreview />
        </local:ModuleWorkspaceShell.PreviewContent>

        <local:ModuleWorkspaceShell.WorkspaceContent>
            <StackPanel
                MaxWidth="1460"
                Margin="32,12,24,48"
                HorizontalAlignment="Center"
                Spacing="20">
                <Border Style="{StaticResource ModuleSectionCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ModuleSectionTitleStyle}" Text="1 · Braid inputs" />
                            <TextBlock Style="{StaticResource ModuleSupportingTextStyle}" Text="Enter the physical cable and braid requirements. These supporting inputs stay neutral so the calculated machine results remain the visual focus." />
                        </StackPanel>
                        <Border
                            BorderBrush="{StaticResource ModuleResultBorderBrush}"
                            BorderThickness="2"
                            Style="{StaticResource ModuleBackgroundCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="TARGET BRAID DEFINITION" />
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Header="Target coverage (%)" Maximum="99.99" Minimum="0.01" SmallChange="1" SpinButtonPlacementMode="Compact" Value="{Binding TargetCoveragePercent, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="Single core OD (mm)" Minimum="0.001" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="{Binding CoreOutsideDiameterMillimetres, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="2" DisplayMemberPath="Display" Header="Number of cores and lay-up" HorizontalAlignment="Stretch" ItemsSource="{Binding CoreLayouts}" SelectedItem="{Binding SelectedCoreLayout, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Ends per carrier" HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableEndCounts}" SelectedItem="{Binding SelectedEndCount, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" DisplayMemberPath="Display" Header="Retained Copper braid wire" HorizontalAlignment="Stretch" ItemsSource="{Binding BraidWireOptions}" SelectedItem="{Binding SelectedBraidWire, Mode=TwoWay}" />
                            <NumberBox Grid.Column="2" Header="Target cable length (m)" Minimum="0.001" SmallChange="1" SpinButtonPlacementMode="Compact" Value="{Binding CableLengthMetres, Mode=TwoWay}" />
                        </Grid>
                        <InfoBar
                            IsOpen="True"
                            Message="{Binding BraidWireSourceStatus}"
                            Severity="Informational"
                            Style="{StaticResource ModuleStatusInfoBarStyle}"
                            Title="Copper-backed braid wire" />
                        <TextBlock Style="{StaticResource ModuleSupportingTextStyle}" Text="{Binding SelectedWireDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModuleSectionCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ModuleSectionTitleStyle}" Text="2 · Coverage calculation flow" />
                            <TextBlock Style="{StaticResource ModuleSupportingTextStyle}" Text="The selected cable envelope and target fill feed both machine configurations in parallel. Stable result styling means neither option is presented as a recommendation without an approved rule." />
                        </StackPanel>

                        <Border Style="{StaticResource ModuleBackgroundCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="SELECTED LAY-UP" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding CoreLayoutDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="MEAN CABLE OD" />
                                    <TextBlock Style="{StaticResource ModuleMetricValueStyle}" Text="{Binding MeanOutsideDiameterDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="TARGET FILL" />
                                    <TextBlock Style="{StaticResource ModuleMetricValueStyle}" Text="{Binding TargetFillDisplay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <FontIcon HorizontalAlignment="Center" Foreground="{StaticResource ModuleFlowConnectorBrush}" Glyph="&#xE70D;" />

                        <InfoBar
                            IsOpen="True"
                            Message="{Binding RecommendationDisplay}"
                            Severity="Success"
                            Style="{StaticResource ModuleStatusInfoBarStyle}"
                            Title="Recommended carrier" />

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SixteenCarrierResultCard" Style="{StaticResource ModuleBackgroundCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="16-carrier braid" />
                                        <Border x:Name="SixteenRecommendationBadge" Grid.Column="1" Padding="10,5" Background="{StaticResource ModuleRecommendedBrush}" CornerRadius="12" Visibility="Collapsed">
                                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="RECOMMENDED" />
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource ModulePrimaryResultCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="TARGET BRAID RESULT" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="REQUIRED PITCH" />
                                                    <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="{Binding SixteenCarrierPitchDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="BRAID ANGLE" />
                                                    <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="{Binding SixteenCarrierLongitudinalAngleDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="3">
                                                    <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="WIRE / BOBBIN" />
                                                    <TextBlock Foreground="White" FontSize="18" FontWeight="SemiBold" Text="{Binding SixteenCarrierLengthDisplay}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ModuleBackgroundCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="REFERENCE CHECK · 55 mm PITCH" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="COVERAGE" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SixteenCarrierReferenceCoverageDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="PERPENDICULAR ANGLE" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SixteenCarrierPerpendicularAngleDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="BASE FILL" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SixteenCarrierBaseFillDisplay}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource ModuleSupportingTextStyle}" Text="{Binding SixteenCarrierTotalStrandsDisplay}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="TwentyFourCarrierResultCard" Grid.Column="1" Style="{StaticResource ModuleBackgroundCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="24-carrier braid" />
                                        <Border x:Name="TwentyFourRecommendationBadge" Grid.Column="1" Padding="10,5" Background="{StaticResource ModuleRecommendedBrush}" CornerRadius="12" Visibility="Collapsed">
                                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="RECOMMENDED" />
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource ModulePrimaryResultCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="TARGET BRAID RESULT" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="REQUIRED PITCH" />
                                                    <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="{Binding TwentyFourCarrierPitchDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="BRAID ANGLE" />
                                                    <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="{Binding TwentyFourCarrierLongitudinalAngleDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="3">
                                                    <TextBlock Foreground="{StaticResource ModuleResultSecondaryTextBrush}" Style="{StaticResource ModuleMetricLabelStyle}" Text="WIRE / BOBBIN" />
                                                    <TextBlock Foreground="White" FontSize="18" FontWeight="SemiBold" Text="{Binding TwentyFourCarrierLengthDisplay}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ModuleBackgroundCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="REFERENCE CHECK · 55 mm PITCH" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="COVERAGE" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TwentyFourCarrierReferenceCoverageDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="PERPENDICULAR ANGLE" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TwentyFourCarrierPerpendicularAngleDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Style="{StaticResource ModuleMetricLabelStyle}" Text="BASE FILL" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TwentyFourCarrierBaseFillDisplay}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource ModuleSupportingTextStyle}" Text="{Binding TwentyFourCarrierTotalStrandsDisplay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander Header="Full braid calculation trace" IsExpanded="False">
                    <StackPanel Margin="0,14,0,0" Spacing="4">
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource ModuleSupportingTextStyle}" Text="Every workbook-derived intermediate value, formula, substituted input and rounding rule is shown below." />
                        <ItemsRepeater ItemTemplate="{StaticResource BraidCalculationStepTemplate}" ItemsSource="{Binding CalculationSteps}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinColumnSpacing="10" MinItemWidth="430" MinRowSpacing="4" ItemsJustification="SpaceBetween" ItemsStretch="Fill" Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </local:ModuleWorkspaceShell.WorkspaceContent>
    </local:ModuleWorkspaceShell>
</UserControl>
