<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATAG.Costing.WinUI.BraidLivePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="14">
        <InfoBar
            Style="{StaticResource ModuleStatusInfoBarStyle}"
            Message="The diagrams consume the visible module inputs and results. They do not calculate or replace the workbook-derived values."
            Severity="Informational"
            Title="Visual check, not a hidden formula" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="Preview detail" />
                <TextBlock Style="{StaticResource ModuleSupportingTextStyle}" Text="Detailed mode separates the retained ends within each carrier bundle and shows the alternating over-under weave." TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch
                x:Name="DetailedPreviewToggle"
                Grid.Column="1"
                Header="Detailed"
                OffContent="Simple"
                OnContent="Detailed"
                Toggled="DetailedPreviewToggle_Toggled" />
        </Grid>

        <Border Style="{StaticResource ModuleBackgroundCardStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="16-carrier braid" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{StaticResource ModuleResultBorderBrush}"
                        Text="{Binding SixteenCarrierPitchDisplay}" />
                </Grid>
                <Canvas
                    x:Name="SixteenCarrierCanvas"
                    Height="132"
                    HorizontalAlignment="Stretch"
                    SizeChanged="PreviewCanvas_SizeChanged" />
                <TextBlock
                    Style="{StaticResource ModuleSupportingTextStyle}"
                    Text="{Binding SixteenCarrierStrandsDisplay}" />
                <TextBlock
                    Style="{StaticResource ModuleSupportingTextStyle}"
                    Text="{Binding SixteenCarrierCoverageDisplay}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ModuleBackgroundCardStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="24-carrier braid" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{StaticResource ModuleResultBorderBrush}"
                        Text="{Binding TwentyFourCarrierPitchDisplay}" />
                </Grid>
                <Canvas
                    x:Name="TwentyFourCarrierCanvas"
                    Height="132"
                    HorizontalAlignment="Stretch"
                    SizeChanged="PreviewCanvas_SizeChanged" />
                <TextBlock
                    Style="{StaticResource ModuleSupportingTextStyle}"
                    Text="{Binding TwentyFourCarrierStrandsDisplay}" />
                <TextBlock
                    Style="{StaticResource ModuleSupportingTextStyle}"
                    Text="{Binding TwentyFourCarrierCoverageDisplay}" />
            </StackPanel>
        </Border>

        <TextBlock
            FontSize="11"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="The preview is a scaled visual check. The labelled pitch, coverage and strand-length values remain authoritative."
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
