<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ATAG.Costing.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ATAG.Costing.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AtagNavyColor">#10263D</Color>
            <Color x:Key="AtagBlueColor">#1679B8</Color>
            <Color x:Key="AtagCyanColor">#43B8D4</Color>
            <!-- This app-local value is replaced from the user's appearance
                 preference before the first page is created. It never changes
                 the Windows accent colour. -->
            <Color x:Key="SystemAccentColor">#F78370</Color>
            <Color x:Key="SystemAccentColorLight3">#FDE0DB</Color>
            <Color x:Key="SystemAccentColorLight2">#FBC1B8</Color>
            <Color x:Key="SystemAccentColorLight1">#F9A295</Color>
            <Color x:Key="SystemAccentColorDark1">#C6695A</Color>
            <Color x:Key="SystemAccentColorDark2">#945043</Color>
            <Color x:Key="SystemAccentColorDark3">#63342D</Color>

            <!-- Keep the controls on app-owned brush instances. Re-colouring
                 these instances at run time updates System, Light and Dark
                 modes immediately and preserves the exact selected RGB value. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F78370" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6F78370" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCF78370" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#5CF78370" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F78370" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E6F78370" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#CCF78370" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#5CF78370" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="Black" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#99000000" />

            <SolidColorBrush x:Key="AtagNavyBrush" Color="{StaticResource AtagNavyColor}" />
            <SolidColorBrush x:Key="AtagBlueBrush" Color="{StaticResource AtagBlueColor}" />
            <SolidColorBrush x:Key="AtagCyanBrush" Color="{StaticResource AtagCyanColor}" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Shared module vocabulary.  Feature pages use these resources so
                 primary results remain visually prominent, supporting data
                 stays quiet, and semantic state is carried by the accessible
                 WinUI InfoBar palette instead of one-off colours. -->
            <Style
                x:Key="ModuleHeaderCardStyle"
                BasedOn="{StaticResource CardBorderStyle}"
                TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="4,1,1,1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style
                x:Key="ModuleSectionCardStyle"
                BasedOn="{StaticResource CardBorderStyle}"
                TargetType="Border">
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style
                x:Key="ModuleBackgroundCardStyle"
                BasedOn="{StaticResource CardBorderStyle}"
                TargetType="Border">
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>

            <Style
                x:Key="ModulePrimaryResultCardStyle"
                BasedOn="{StaticResource CardBorderStyle}"
                TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="ModuleSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ModuleSupportingTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ModuleMetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ModuleMetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ModuleStatusInfoBarStyle" TargetType="InfoBar">
                <Setter Property="IsClosable" Value="False" />
                <Setter Property="IsOpen" Value="True" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
