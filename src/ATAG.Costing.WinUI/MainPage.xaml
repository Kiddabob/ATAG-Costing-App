                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="A configured link is checked every 30 seconds. After a failed check, automatic attempts pause and this manual refresh is required; cached tables and manual project save remain available."
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            IsActive="{Binding IsRefreshingCentralData}" />
                                        <Button
                                            Click="RefreshCentralData_Click"
                                            Content="Refresh link" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="SettingsView"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="860"
                            Margin="32,16,32,40"
                            HorizontalAlignment="Left"
                            Spacing="20">
                            <TextBlock
                                Style="{StaticResource SectionLabelStyle}"
                                Text="APPEARANCE" />

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="App colour mode" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Follow Windows by default, or override the app only."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Header="Choose a mode"
                                            SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                                            SelectionChanged="ThemeMode_SelectionChanged">
                                            <ComboBoxItem Content="Use system setting" />
                                            <ComboBoxItem Content="Light" />
                                            <ComboBoxItem Content="Dark" />
                                        </ComboBox>
                                    </Grid>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="Window material" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Mica is calmer; acrylic is more translucent."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Header="Backdrop"
                                            SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}"
                                            SelectionChanged="BackdropMode_SelectionChanged">
                                            <ComboBoxItem Content="Mica" />
                                            <ComboBoxItem Content="Acrylic" />
                                        </ComboBox>
                                    </Grid>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="Windows visual settings" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Change the Windows accent, system theme, text size, or contrast settings used across compatible apps."
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="OpenWindowsSetting_Click"
                                                Content="Colours"
                                                Tag="ms-settings:colors" />
                                            <Button
                                                Click="OpenWindowsSetting_Click"
                                                Content="Themes"
                                                Tag="ms-settings:themes" />
                                            <Button
                                                Click="OpenWindowsSetting_Click"
                                                Content="Text size"
                                                Tag="ms-settings:easeofaccess-display" />
                                            <Button
                                                Click="OpenWindowsSetting_Click"
                                                Content="Contrast themes"
                                                Tag="ms-settings:easeofaccess-highcontrast" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Style="{StaticResource SectionLabelStyle}"
                                Text="STORAGE AND FILES" />

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="Default save location" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.StorageFolderDisplay, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Click="OpenStorageFolder_Click"
                                                Content="Open folder"
                                                IsEnabled="{x:Bind ViewModel.HasStorageFolder, Mode=OneWay}" />
                                            <Button
                                                Click="ChooseFolder_Click"
                                                Content="Change folder"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="Show storage setup when the app starts" />
                                            <TextBlock
                                                MaxWidth="600"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="This is on by default. Turning it off here is the only way to stop the startup screen appearing."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            Header="Startup prompt"
                                            IsOn="{x:Bind ViewModel.ShowStorageSetupOnStartup, Mode=TwoWay}" />
                                    </Grid>

                                    <Button
                                        HorizontalAlignment="Left"
                                        Click="ShowStorageSetup_Click"
                                        Content="Show storage setup now" />
                                </StackPanel>
                            </Border>

                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="If the selected folder becomes unavailable, setup will appear even when the startup option is off."
                                Severity="Informational"
                                Title="Safe fallback" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Grid
            x:Name="StorageSetupOverlay"
            Canvas.ZIndex="20"
            Background="#E6101B29"
            Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalContentAlignment="Center"
                VerticalScrollBarVisibility="Auto">
                <Border
                    MaxWidth="860"
                    Margin="24"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="16">
                    <Border
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AtagBlueBrush}"
                        CornerRadius="14">
                        <FontIcon
                            FontSize="28"
                            Foreground="White"
                            Glyph="&#xE8B7;" />
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Set up ATAG Costing"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="15"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose a save location, then link the five LIVE central-data tables. No customer or material cache is included with a clean installation."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Padding="16"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                Foreground="{StaticResource AtagBlueBrush}"
                                Glyph="&#xE838;" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="SELECTED LOCATION" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.StorageFolderDisplay, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                Foreground="{StaticResource AtagBlueBrush}"
                                Glyph="&#xE8F1;" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="LIVE CENTRAL DATA" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.CentralDataSetupStatus, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.CentralDataMissingAreasDisplay, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="SetupFirstRunCentralData_Click"
                                Content="Link a table"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.StorageStatusMessage, Mode=OneWay}"
                        Severity="Informational" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="On a first run, Continue becomes available only after a save folder and all five database tables have been linked and imported. Later, the startup reminder can be changed in Settings."
                        TextWrapping="Wrap" />

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Click="ChooseFolder_Click"
                            Content="Choose folder" />
                        <Button
                            Click="ContinueFromStorageSetup_Click"
                            Content="Continue"
                            IsEnabled="{x:Bind ViewModel.CanContinueSetup, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
