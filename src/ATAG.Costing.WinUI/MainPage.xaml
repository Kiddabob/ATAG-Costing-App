<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ATAG.Costing.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ATAG.Costing.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:HexColourBrushConverter x:Key="HexColourBrushConverter" />
        <DataTemplate x:Key="CalculationFlowNodeTemplate">
            <Border
                Margin="0,0,0,6"
                Padding="12"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="8">
                <StackPanel Spacing="5">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Label}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="100"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"
                            Text="{Binding Result}"
                            TextAlignment="Right"
                            TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding BusinessMeaning}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Formula}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding SubstitutedFormula}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="8,5"
                        Background="#293E50"
                        CornerRadius="5">
                        <TextBlock
                            FontSize="11"
                            Foreground="#D2E8F5"
                            Text="{Binding InputSummary}"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{Binding Warning}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CalculationFlowStageTemplate">
            <StackPanel HorizontalAlignment="Stretch" Spacing="4">
                <Border
                    Padding="14"
                    HorizontalAlignment="Stretch"
                    Background="{Binding BackgroundHex, Converter={StaticResource HexColourBrushConverter}}"
                    CornerRadius="10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Header}" />
                            <TextBlock
                                Foreground="#D1E0EA"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsRepeater
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource CalculationFlowNodeTemplate}"
                            ItemsSource="{Binding Nodes}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    MinColumnSpacing="10"
                                    MinItemWidth="330"
                                    MinRowSpacing="6"
                                    ItemsJustification="SpaceBetween"
                                    ItemsStretch="Fill"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AtagBlueBrush}"
                    Text="{Binding ConnectorText}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ContactSuggestionTemplate">
            <StackPanel MinWidth="420" Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding AccountName}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding ShortName}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding PostCode}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CentralDataLinkStatusTemplate">
            <Grid Padding="8,5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    Width="9"
                    Height="9"
                    VerticalAlignment="Center"
                    Fill="{Binding BackgroundHex, Converter={StaticResource HexColourBrushConverter}}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding AreaName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            Text="{Binding Status}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Detail}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <NavigationView
            x:Name="AppNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            PaneTitle="ATAG Costing"
            SelectionChanged="AppNavigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" IsSelected="True" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CostingNavigationItem"
                    Content="Costing workspace"
                    IsExpanded="True"
                    Tag="costing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Live result" Tag="costing-section:results" />
                        <NavigationViewItem Content="Costing basis" Tag="costing-section:basis" />
                        <NavigationViewItem Content="Conductor" Tag="costing-section:conductor" />
                        <NavigationViewItem Content="Insulation compound" Tag="costing-section:compound" />
                        <NavigationViewItem Content="Masterbatch colour" Tag="costing-section:masterbatch" />
                        <NavigationViewItem Content="Core print" Tag="costing-section:print" />
                        <NavigationViewItem Content="Production and labour" Tag="costing-section:labour" />
                        <NavigationViewItem Content="Customer and core name" Tag="costing-section:name" />
                        <NavigationViewItem Content="Quotation" Tag="costing-section:quotation" />
                        <NavigationViewItem Content="Calculation trace" Tag="costing-section:trace" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="Contract review" Tag="contract-review">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Live Data" Tag="materials">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Braid calculator" Tag="braid">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reports" Tag="reports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button
                    Margin="8,8,8,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <StackPanel Width="260" Spacing="6">
                                <TextBlock
                                    Margin="8,2,8,4"
                                    FontWeight="SemiBold"
                                    Text="Linked central-data tables" />
                                <ItemsRepeater
                                    ItemTemplate="{StaticResource CentralDataLinkStatusTemplate}"
                                    ItemsSource="{x:Bind CostingViewModel.CentralDataLinkStatuses, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="RefreshCentralData_Click"
                                    Content="Refresh linked tables"
                                    ToolTipService.ToolTip="Refresh the configured Access or SQL material links" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="CentralDataConnectionDot"
                            Width="11"
                            Height="11"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorCautionBrush}" />
                        <StackPanel Grid.Column="1" MaxWidth="180" Spacing="1">
                            <TextBlock
                                x:Name="CentralDataConnectionText"
                                FontWeight="SemiBold"
                                Text="Live Data · cached"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Show each table link"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button>
            </NavigationView.PaneFooter>

            <NavigationView.Header>
                <StackPanel Spacing="3">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PageDescription, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.Header>

            <NavigationView.Content>
                <Grid>
                    <ScrollViewer x:Name="HomeView">
                        <StackPanel Margin="32,12,32,40" Spacing="24">
                            <Border
                                Padding="28"
                                Background="{StaticResource AtagNavyBrush}"
                                CornerRadius="16">
                                <Grid>
                                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="10">
                                        <TextBlock
                                            Foreground="{StaticResource AtagCyanBrush}"
                                            Style="{StaticResource SectionLabelStyle}"
                                            Text="COSTING WORKSPACE" />
                                        <TextBlock
                                            FontSize="30"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Clear calculations. Modular cable builds."
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="15"
                                            Foreground="#D9E7F2"
                                            Text="Every cost will show its inputs, formula, intermediate values, units and rounding—without navigating hidden worksheets."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="12">
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Choose the construction to start" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Each costing starts from a physical cable construction so the editor can build from the conductor outwards."
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        MinHeight="132"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        Click="ModuleCard_Click"
                                        Tag="costing">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="96" Height="64">
                                                <Canvas Width="96" Height="64">
                                                    <Ellipse
                                                        Width="52"
                                                        Height="52"
                                                        Canvas.Left="22"
                                                        Canvas.Top="6"
                                                        Fill="#65CDE8"
                                                        Stroke="#D9E7F2"
                                                        StrokeThickness="2" />
                                                    <Ellipse
                                                        Width="26"
                                                        Height="26"
                                                        Canvas.Left="35"
                                                        Canvas.Top="19"
                                                        Fill="#C7782E"
                                                        Stroke="#F4C28B"
                                                        StrokeThickness="1.5" />
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="COR · Single insulated core" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="One conductor, one insulation compound and its masterbatch. Working V1."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinHeight="132"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        Click="ModuleCard_Click"
                                        Tag="costing-dual">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="96" Height="64">
                                                <Canvas Width="96" Height="64">
                                                    <Ellipse
                                                        Width="60"
                                                        Height="60"
                                                        Canvas.Left="18"
                                                        Canvas.Top="2"
                                                        Fill="#315D82"
                                                        Stroke="#D9E7F2"
                                                        StrokeThickness="2" />
                                                    <Ellipse
                                                        Width="44"
                                                        Height="44"
                                                        Canvas.Left="26"
                                                        Canvas.Top="10"
                                                        Fill="#65CDE8"
                                                        Stroke="#AEEBFA"
                                                        StrokeThickness="1.5" />
                                                    <Ellipse
                                                        Width="22"
                                                        Height="22"
                                                        Canvas.Left="37"
                                                        Canvas.Top="21"
                                                        Fill="#C7782E"
                                                        Stroke="#F4C28B"
                                                        StrokeThickness="1.5" />
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Dual insulated" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Two independent extrusion layers with optional tape, chalk, foil, screen and drain modules."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        MinHeight="132"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        Click="ModuleCard_Click"
                                        Tag="costing-flat">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="96" Height="64">
                                                <Canvas Width="96" Height="64">
                                                    <Border
                                                        Width="92"
                                                        Height="42"
                                                        Canvas.Left="2"
                                                        Canvas.Top="11"
                                                        Background="#4D65CDE8"
                                                        BorderBrush="#D9E7F2"
                                                        BorderThickness="2"
                                                        CornerRadius="14" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="9" Canvas.Top="23" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="13.5" Canvas.Top="27.5" Fill="#C7782E" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="30" Canvas.Top="23" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="34.5" Canvas.Top="27.5" Fill="#C7782E" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="51" Canvas.Top="23" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="55.5" Canvas.Top="27.5" Fill="#C7782E" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="72" Canvas.Top="23" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="76.5" Canvas.Top="27.5" Fill="#C7782E" />
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Flat cable" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Future construction for up to ten cores arranged in a line."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        MinHeight="132"
                                        Padding="20"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        Click="ModuleCard_Click"
                                        Tag="costing-dshape">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="96" Height="64">
                                                <Canvas Width="96" Height="64">
                                                    <Path
                                                        Data="M 5,54 L 91,54 Q 94,54 94,50 L 94,31 C 94,12 76,3 48,3 C 20,3 2,12 2,31 L 2,50 Q 2,54 5,54 Z"
                                                        Fill="#4D65CDE8"
                                                        Stroke="#D9E7F2"
                                                        StrokeThickness="2" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="9" Canvas.Top="26" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="13.5" Canvas.Top="30.5" Fill="#C7782E" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="30" Canvas.Top="26" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="34.5" Canvas.Top="30.5" Fill="#C7782E" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="51" Canvas.Top="26" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="55.5" Canvas.Top="30.5" Fill="#C7782E" />
                                                    <Ellipse Width="17" Height="17" Canvas.Left="72" Canvas.Top="26" Fill="#65CDE8" Stroke="#AEEBFA" StrokeThickness="1" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="76.5" Canvas.Top="30.5" Fill="#C7782E" />
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="D-shape cable" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Future in-line construction for up to ten cores with a D-shaped finish."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <FontIcon
                                            HorizontalAlignment="Left"
                                            FontSize="24"
                                            Foreground="{StaticResource AtagBlueBrush}"
                                            Glyph="&#xE8B7;" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="Live Data" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Copper, compounds, masterbatch colours, supplier quotes and yields."
                                            TextWrapping="Wrap" />
                                        <Button
                                            HorizontalAlignment="Left"
                                            Click="ModuleCard_Click"
                                            Content="Open module"
                                            Tag="materials" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <FontIcon
                                            HorizontalAlignment="Left"
                                            FontSize="24"
                                            Foreground="{StaticResource AtagBlueBrush}"
                                            Glyph="&#xE9D2;" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="Braid calculator" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Coverage, pitch, carrier comparison and buncher lay settings."
                                            TextWrapping="Wrap" />
                                        <Button
                                            HorizontalAlignment="Left"
                                            Click="ModuleCard_Click"
                                            Content="Open module"
                                            Tag="braid" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <FontIcon
                                            HorizontalAlignment="Left"
                                            FontSize="24"
                                            Foreground="{StaticResource AtagBlueBrush}"
                                            Glyph="&#xE8A5;" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="Reports &amp; review" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Quotes, costing summaries, contract reviews and printable audit trails."
                                            TextWrapping="Wrap" />
                                        <Button
                                            HorizontalAlignment="Left"
                                            Click="ModuleCard_Click"
                                            Content="Open module"
                                            Tag="reports" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="44"
                                        Height="44"
                                        Background="{StaticResource AtagBlueBrush}"
                                        CornerRadius="10">
                                        <FontIcon
                                            Foreground="White"
                                            Glyph="&#xE838;" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="Current save location" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.StorageFolderDisplay, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        Click="OpenSettings_Click"
                                        Content="Storage settings"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="ModulePlaceholderView"
                        Visibility="Collapsed">
                        <Grid Margin="32,24,32,40">
                            <Border
                                MaxWidth="820"
                                HorizontalAlignment="Left"
                                Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="16">
                                    <Border
                                        Width="54"
                                        Height="54"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AtagBlueBrush}"
                                        CornerRadius="12">
                                        <FontIcon
                                            FontSize="24"
                                            Foreground="White"
                                            Glyph="&#xE946;" />
                                    </Border>
                                    <TextBlock
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="Module boundary ready" />
                                    <TextBlock
                                        MaxWidth="680"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="The single-core V1 is available in Costing workspace. Its material rules are isolated, tested, and fully traceable."
                                        TextWrapping="Wrap" />
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="No Excel dependency will be required at runtime."
                                        Severity="Success"
                                        Title="Architecture confirmed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="DualConstructionView"
                        Visibility="Collapsed">
                        <StackPanel Margin="32,16,32,48" Spacing="20">
                            <Border
                                Padding="24"
                                Background="{StaticResource AtagNavyBrush}"
                                CornerRadius="16">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{StaticResource AtagCyanBrush}"
                                        Style="{StaticResource SectionLabelStyle}"
                                        Text="DUAL INSULATED CONSTRUCTION" />
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Build the cable from the copper outwards"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="#D9E7F2"
                                        Text="The material calculator is verified. This construction planner fixes the physical layer order before the full guided dual editor is connected."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="The conductor and first insulation use quote length plus the internal 200 m start-up. The second insulation uses quote length only. The 3% allowance is applied once to every material stream; masterbatch adds material cost only."
                                Severity="Success"
                                Title="Confirmed calculation boundary" />

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Optional modules after the first insulation" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Select any modules required between the first and second insulation layers. The flow below updates in its physical inside-to-outside order."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="16" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox
                                            x:Name="DualTapeSelection"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Checked="DualModuleSelection_Changed"
                                            Content="Tape"
                                            Unchecked="DualModuleSelection_Changed" />
                                        <CheckBox
                                            x:Name="DualChalkSelection"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Checked="DualModuleSelection_Changed"
                                            Content="Chalk"
                                            Unchecked="DualModuleSelection_Changed" />
                                        <CheckBox
                                            x:Name="DualFoilSelection"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Checked="DualModuleSelection_Changed"
                                            Content="Foil"
                                            Unchecked="DualModuleSelection_Changed" />
                                        <CheckBox
                                            x:Name="DualBraidSelection"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Checked="DualModuleSelection_Changed"
                                            Content="Braid"
                                            Unchecked="DualModuleSelection_Changed" />
                                        <CheckBox
                                            x:Name="DualLapscreenSelection"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Checked="DualModuleSelection_Changed"
                                            Content="Lapscreen"
                                            Unchecked="DualModuleSelection_Changed" />
                                        <CheckBox
                                            x:Name="DualDrainSelection"
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Checked="DualModuleSelection_Changed"
                                            Content="Drain wire"
                                            Unchecked="DualModuleSelection_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Inside → outside construction flow" />
                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Auto"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollBarVisibility="Disabled"
                                        VerticalScrollMode="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border
                                                MinWidth="170"
                                                Padding="16"
                                                Background="{StaticResource AtagNavyBrush}"
                                                CornerRadius="12">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Foreground="{StaticResource AtagCyanBrush}" Text="1 · CENTRE" />
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White" Text="Copper conductor" />
                                                    <TextBlock Foreground="#D9E7F2" Text="Costed once" />
                                                </StackPanel>
                                            </Border>
                                            <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                            <Border
                                                MinWidth="210"
                                                Padding="16"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="12">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="2 · FIRST EXTRUSION" />
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Compound + masterbatch" />
                                                    <TextBlock Text="Quote + internal start-up" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel
                                                x:Name="DualTapeFlow"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="Collapsed">
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                                <Border MinWidth="125" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock FontWeight="SemiBold" Text="Tape" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel
                                                x:Name="DualChalkFlow"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="Collapsed">
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                                <Border MinWidth="125" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock FontWeight="SemiBold" Text="Chalk" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel
                                                x:Name="DualFoilFlow"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="Collapsed">
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                                <Border MinWidth="125" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock FontWeight="SemiBold" Text="Foil" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel
                                                x:Name="DualBraidFlow"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="Collapsed">
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                                <Border MinWidth="125" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock FontWeight="SemiBold" Text="Braid" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel
                                                x:Name="DualLapscreenFlow"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="Collapsed">
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                                <Border MinWidth="125" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock FontWeight="SemiBold" Text="Lapscreen" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel
                                                x:Name="DualDrainFlow"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="Collapsed">
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                                <Border MinWidth="135" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock FontWeight="SemiBold" Text="Drain wire" />
                                                </Border>
                                            </StackPanel>

                                            <FontIcon VerticalAlignment="Center" Glyph="&#xE72A;" />
                                            <Border
                                                MinWidth="210"
                                                Padding="16"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="12">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="FINAL · SECOND EXTRUSION" />
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Compound + masterbatch" />
                                                    <TextBlock Text="Finished quote length only" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="First extrusion production profile" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Own size-to-speed table, set-up time, operators and labour rate. It runs the conductor and first layer including start-up."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Second extrusion production profile" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Independent size-to-speed table, set-up time, operators and labour rate. It runs the finished quote length only."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="The optional scaled cross-section and side-profile renderer is specified for the next visual slice. It will remain off by default and will consume this same ordered construction model."
                                Severity="Informational"
                                Title="Live cable view staged" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid
                        x:Name="CostingWorkspaceView"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="PinnedResultBar"
                            Margin="32,8,32,4"
                            Padding="16"
                            Background="{StaticResource AtagNavyBrush}"
                            CornerRadius="14"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="18" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.RowSpan="2" Spacing="3">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource AtagCyanBrush}"
                                        Text="PINNED LIVE RESULT" />
                                    <TextBlock
                                        FontSize="25"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding MarkedUpCostPerMetreDisplay}" />
                                    <TextBlock
                                        Foreground="#AFC7D8"
                                        Text="{Binding EffectiveCoreNameDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#AFC7D8"
                                        Text="MATERIAL QUOTE" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding CoreMaterialQuoteDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#AFC7D8"
                                        Text="LABOUR QUOTE" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding LabourCostDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#AFC7D8"
                                        Text="ESTIMATED COST" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding TotalEstimatedCostDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#AFC7D8"
                                        Text="CUSTOMER QUOTATION" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding ConvertedQuoteDisplay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="3"
                                    Grid.RowSpan="2"
                                    VerticalAlignment="Center"
                                    Click="UnpinResults_Click"
                                    ToolTipService.ToolTip="Unpin live result">
                                    <FontIcon Glyph="&#xE77A;" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Margin="32,4,32,6"
                            Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="OpenSingleCoreProject_Click"
                                        Content="Open costing" />
                                    <Button
                                        Click="SaveSingleCoreProject_Click"
                                        Content="Save costing" />
                                    <Button Content="Revision actions">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem
                                                    Click="DuplicateSingleCoreProject_Click"
                                                    Icon="Copy"
                                                    Text="Duplicate as new project" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="ApproveSingleCoreRevision_Click"
                                                    Icon="Accept"
                                                    Text="Approve current revision" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Content="Jump to section">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="basis" Text="Costing basis" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="conductor" Text="Conductor" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="compound" Text="Insulation compound" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="masterbatch" Text="Masterbatch colour" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="print" Text="Core print" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="labour" Text="Production and labour" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="name" Text="Core name" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="results" Text="Results and quotation" />
                                                <MenuFlyoutItem Click="JumpToCostingSection_Click" Tag="trace" Text="Calculation trace" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Grid
                            x:Name="CostingEditorLayout"
                            Grid.Row="2"
                            ColumnSpacing="0"
                            SizeChanged="CostingEditorLayout_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition x:Name="PreviewBottomDockRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="8" />
                                <ColumnDefinition x:Name="PreviewRailColumn" Width="600" />
                            </Grid.ColumnDefinitions>
                        <ScrollViewer
                            x:Name="CostingWorkspaceScroller"
                            Grid.Row="0"
                            Grid.Column="0">
                        <StackPanel Margin="32,12,32,48" Spacing="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Single insulated core costing" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="This construction was selected from Home. Build the COR from its conductor outwards, with every material and production value kept visible and traceable."
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Margin="0,6,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding RevisionStatusDisplay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SaveStateDisplay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="This working V1 covers one conductor, one insulation compound, one masterbatch, and production labour. Waste/start-up, risk, markup, and alternate selling-price methods are separate visible steps. Sheath, braid, and further cable builds remain later modules."
                                Severity="Informational"
                                Title="Single-core V1" />

                            <Border
                                x:Name="ResultsSection"
                                Padding="22"
                                Background="{StaticResource AtagNavyBrush}"
                                CornerRadius="14">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource AtagCyanBrush}"
                                            Style="{StaticResource SectionLabelStyle}"
                                            Text="ONE-CORE LIVE RESULT" />
                                        <ToggleButton
                                            x:Name="PinResultsButton"
                                            Grid.Column="1"
                                            Click="PinResults_Click"
                                            ToolTipService.ToolTip="Pin this result while the costing scrolls">
                                            <FontIcon Glyph="&#xE718;" />
                                        </ToggleButton>
                                        <Button
                                            Grid.Column="2"
                                            Click="OpenResultWindow_Click"
                                            ToolTipService.ToolTip="Open an always-on-top movable, resizable live result window">
                                            <FontIcon Glyph="&#xE8A7;" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontSize="34"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding MarkedUpCostPerMetreDisplay}" />
                                            <TextBlock
                                                Foreground="#D9E7F2"
                                                Text="per metre including risk and markup" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#AFC7D8"
                                                Text="CUSTOMER QUOTATION TOTAL" />
                                            <TextBlock
                                                FontSize="30"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding ConvertedQuoteDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#416177" />
                                    <Grid RowSpacing="12" ColumnSpacing="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Foreground="#AFC7D8" Text="Material quote" />
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding CoreMaterialQuoteDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Foreground="#AFC7D8" Text="Labour quote" />
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding LabourCostDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock Foreground="#AFC7D8" Text="Estimated cost" />
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding TotalEstimatedCostDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                            <TextBlock Foreground="#AFC7D8" Text="Cost including risk" />
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding RiskAdjustedQuoteDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid RowSpacing="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="16">
                                    <Border
                                        x:Name="CostingBasisSection"
                                        Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="14">
                                            <TextBlock
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="Costing basis" />
                                            <Grid RowSpacing="12" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <NumberBox
                                                    Header="Quote length (m)"
                                                    Minimum="0.001"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{Binding QuoteLengthMetres, Mode=TwoWay}" />
                                                <NumberBox
                                                    Grid.Column="1"
                                                    Header="Waste/start-up (%)"
                                                    Minimum="0"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{Binding UsageAllowancePercent, Mode=TwoWay}" />
                                                <NumberBox
                                                    Grid.Row="1"
                                                    Header="Risk (%)"
                                                    Minimum="0"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{Binding RiskPercent, Mode=TwoWay}" />
                                                <NumberBox
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Header="Markup (%)"
                                                    Minimum="0"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{Binding MarkupPercent, Mode=TwoWay}" />
                                            </Grid>
                                            <ComboBox
                                                Header="Costing Prepared by"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding OperatorMaterials}"
                                                PlaceholderText="Choose an operator"
                                                SelectedItem="{Binding SelectedOperator, Mode=TwoWay}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Waste/start-up boosts material usage once. Material and labour form the estimated cost; risk is applied next, then markup is applied to the risk-adjusted cost."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        x:Name="ConductorSection"
                                        Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="14">
                                            <TextBlock
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="1 · Conductor" />
                                            <ComboBox
                                                Header="Conductor material / finish"
                                                ItemsSource="{Binding ConductorMaterialTypeOptions}"
                                                PlaceholderText="Choose a material type"
                                                SelectedItem="{Binding SelectedConductorMaterialType, Mode=TwoWay}" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox
                                                    Header="Choose conductor by"
                                                    IsEnabled="{Binding IsConductorGeometrySelectionAvailable}"
                                                    ItemsSource="{Binding ConductorSelectionModes}"
                                                    SelectedIndex="{Binding ConductorSelectionModeIndex, Mode=TwoWay}" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Header="{Binding ConductorSizeHeader}"
                                                    ItemsSource="{Binding ConductorSizeOptions}"
                                                    PlaceholderText="Choose a size or construction"
                                                    SelectedItem="{Binding SelectedConductorSize, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="TCW, PCW, titanium and special constructions are filtered separately. Supplier-defined items such as tinsel replace the size/AWG choice with their recorded description."
                                                TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox
                                                    Header="Copper class"
                                                    ItemsSource="{Binding ConductorClassOptions}"
                                                    SelectedItem="{Binding SelectedConductorClass, Mode=TwoWay}" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Header="Supplier"
                                                    ItemsSource="{Binding ConductorSupplierOptions}"
                                                    SelectedItem="{Binding SelectedConductorSupplier, Mode=TwoWay}" />
                                            </Grid>
                                            <ComboBox
                                                Header="Matched supplier conductor"
                                                DisplayMemberPath="DisplayDescription"
                                                ItemsSource="{Binding CopperMaterials}"
                                                PlaceholderText="Choose a central-data conductor"
                                                SelectedItem="{Binding SelectedCopper, Mode=TwoWay}" />
                                            <Border
                                                Padding="12"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="18" RowSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
